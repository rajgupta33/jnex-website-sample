# Production origin, e.g. https://your-confirmed-domain.com (no trailing path).
VITE_SITE_URL=
# Existing email retained; confirm with JNEX before launch.
VITE_CONTACT_EMAIL=info@jnexeducation.com
# International digits only. Blank shows Contact JNEX instead of a dummy number.
VITE_WHATSAPP_NUMBER=
# Optional HTTPS POST endpoint. Without it, enquiries use a user-sent email draft.
# Client configuration is public. Never put CRM secrets here.
VITE_LEAD_ENDPOINT=
